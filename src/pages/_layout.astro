---
import '../styles/global.css';

import { Font } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  className?: string;
  noMain?: boolean;
}
const { title, description, ogImage, className, noMain } = Astro.props;
const { pathname } = Astro.url;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {
      process.env.NODE_ENV === 'development' ? (
        <>
          <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon-dev.png" />
          <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32-dev.png" />
          <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16-dev.png" />
          <link rel="manifest" href="/site.webmanifest" />
        </>
      ) : (
        <>
          <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
          <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
          <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
          <link rel="manifest" href="/site.webmanifest" />
        </>
      )
    }

    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta name="twitter:title" content={title} />
    <meta name="description" content={description} />
    <meta property="og:description" content={description} />
    <meta name="twitter:description" content={description} />

    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="twitter:card" content={ogImage} />
          <meta property="twitter:image" content={ogImage} />
        </>
      )
    }

    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="theme-color" content="#131314" />
    <base href={`${Astro.url.origin}/`} />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains" preload />

    <slot name="head" />
  </head>

  <body class="text-15">
    <nav
      class:list={[
        'flex justify-end text-sm text-neutral-400',
        'content-container pb-12 pt-2 md:pt-4',
      ]}
    >
      <a
        href="/"
        class:list={[
          'block rounded-md px-3 py-2',
          'hocus:text-white',
          pathname === '/' && 'underline underline-offset-8',
        ]}
      >
        Home
      </a>
      <a
        href="/blog"
        class:list={[
          'block rounded-md px-3 py-2',
          'hocus:text-white',
          pathname.startsWith('/blog') && 'underline underline-offset-8',
          '-mr-3',
        ]}
      >
        Blog
      </a>
    </nav>

    {
      noMain ? (
        <slot />
      ) : (
        <main class:list={['content-container', className]}>
          <slot />
        </main>
      )
    }

    <div class="h-14 md:h-24"></div>
  </body>
</html>
