---
import { getCollection } from 'astro:content';

import Layout from '../_layout.astro';
import PostList from './_post-list.astro';

const blogPosts = await getCollection('blog');
---

<Layout
  title="Afifudin's Blog"
  description="Articles on software engineering, system design, frontend, backend, and lessons learned from building real-world applications."
>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title="Afifudin's Blog"
    href={new URL('rss.xml', Astro.site)}
  />

  <h1 class="font-bold text-2xl sm:text-3xl pb-5">Afifudin's Blog</h1>
  <PostList posts={blogPosts} />
</Layout>
