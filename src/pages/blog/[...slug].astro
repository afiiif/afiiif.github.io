---
import { getCollection, render } from 'astro:content';

import Layout from '../_layout.astro';
import Tags from './_tags.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: entry,
  }));
}

const { Content } = await render(Astro.props);
const { data } = Astro.props;

const formattedPublishDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(data.publishDate);
---

<Layout
  title={data.title}
  description={data.description || data.title}
  ogImage={data.ogImage}
  noMain
>
  <article class="content-container">
    <h1 class="font-bold text-2xl sm:text-3xl sm:leading-snug mb-2 text-balance">{data.title}</h1>
    <div class="text-13 text-neutral-500 flex gap-2 pb-7 font-mono">
      <a href="/" class="no-underline hover:text-neutral-400 focus:text-neutral-400">Afifudin</a>
      <div>·</div>
      <div>{formattedPublishDate}</div>
    </div>
    <Content />
  </article>

  <section class="content-container">
    <nav class="border-t border-neutral-800 pt-4 mt-16">
      <Tags tags={data.tags} className="pb-5" />
      <a href="/blog" class="text-neutral-400 hocus:text-blue-400 text-sm inline-block mt-5 group">
        ← <span class="group-hover:underline underline-offset-4">Read other blog posts</span>
      </a>
    </nav>
  </section>
</Layout>

<script>
  const $headings = document.querySelectorAll('h2,h3') as any as HTMLHeadingElement[];
  $headings.forEach(($heading) => {
    const $a = document.createElement('a');
    $a.ariaHidden = 'true';
    $a.ariaLabel = `Anchor to ${$heading.textContent}`;
    $a.tabIndex = -1;
    $a.href = location.pathname + '#' + $heading.id;
    $a.textContent = '#';
    $heading.insertAdjacentElement('afterbegin', $a);
  });
</script>

<style is:global>
  @reference '../../styles/global.css';

  h2[id] {
    @apply relative;
    > a {
      @apply text-neutral-500/25 font-light;
      @apply absolute -left-4 w-5 no-underline text-[.85em] pt-[.125em];
      @apply md:-left-6 md:w-7 md:text-[1em] md:pt-0;
    }
    &:hover > a {
      @apply text-neutral-500 hover:text-blue-400;
    }
  }

  h3[id] {
    @apply relative;
    > a {
      @apply text-neutral-500 hover:text-blue-400 font-light;
      @apply invisible absolute -left-4 w-5 no-underline text-[.85em] pt-[.125em];
      @apply md:-left-6 md:w-7 md:text-[1em] md:pt-0;
    }
    &:hover > a {
      @apply visible;
    }
  }

  h2 {
    @apply font-bold text-xl sm:text-[1.4rem] mt-16;
    @apply border-b border-b-neutral-800 pb-1.5 mb-6 scroll-mt-7;
  }
  h3 {
    @apply font-bold text-lg mt-7 mb-5;
  }

  p {
    @apply my-5 text-neutral-300;
  }
  .p {
    @apply text-neutral-300;
  }

  ul {
    @apply list-disc pl-6 text-neutral-300;
    li {
      @apply py-1;
      li:first-child {
        @apply pt-2;
      }
    }
  }
  p + ul {
    @apply -mt-4;
  }

  p,
  .p,
  ul {
    a {
      @apply text-blue-400 underline decoration-neutral-700 hocus:decoration-blue-400 underline-offset-3;
    }
  }

  p,
  li {
    code {
      @apply bg-neutral-800 text-white rounded inline-block px-1 mx-0.5;
      @apply text-sm font-extralight;
    }
  }
  a > code {
    @apply bg-neutral-800/70 text-blue-400;
  }

  blockquote {
    @apply pl-3 border-l-4 text-neutral-600;
    p {
      @apply text-neutral-400;
    }
  }

  hr {
    @apply border-neutral-800 my-8;
  }

  .expressive-code pre > code {
    @apply text-13!;
  }

  .expressive-code .ec-line.mark {
    --tmLineBgCol: #264a8959 !important;
  }
</style>
